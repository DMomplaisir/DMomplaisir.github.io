---
/*
 * BlueprintMap Component — Burgundy Blueprint on Warm White
 * Performance: static layers (water lining, grid, boroughs, transit) rendered once to
 * an OffscreenCanvas and cached as an ImageBitmap. Only dynamic elements
 * (trains, crosshair, hover) redraw each frame. ~60 fps on integrated GPUs.
 */

interface Props {
  fullscreen?: boolean;
}

const { fullscreen = false } = Astro.props;
---

<div class={`blueprint-map-wrapper ${fullscreen ? 'is-fullscreen' : ''}`} id="blueprint-wrapper">
  <canvas id="hero-map-canvas" aria-hidden="true"></canvas>

  <div class="map-annotations" aria-hidden="true" id="map-annotations">
    <div class="grid-refs top">
      <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span>
    </div>
    <div class="grid-refs left">
      <span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span>
    </div>

    <div class="title-block" id="title-block">
      <div class="tb-row">
        <span class="tb-label">SITE ANALYSIS</span>
        <span class="tb-value">EAST RIVER CONFLUENCE</span>
      </div>
      <div class="tb-row">
        <span class="tb-label">SCALE</span>
        <span class="tb-value">1 : 24 000</span>
      </div>
      <div class="tb-row">
        <span class="tb-label">DWG</span>
        <span class="tb-value">DM-001 REV A</span>
      </div>
    </div>

    <div class="north-arrow" id="north-arrow">
      <svg width="16" height="28" viewBox="0 0 16 28" fill="none" stroke="currentColor">
        <path d="M8 0L13 11H3L8 0Z" fill="currentColor"/>
        <path d="M8 11V28" stroke-width="1"/>
        <text x="8" y="27" text-anchor="middle" font-size="8" font-family="monospace" fill="currentColor" stroke="none">N</text>
      </svg>
    </div>
  </div>

  <div id="station-tooltip" class="station-tooltip" aria-hidden="true">
    <div class="st-name" id="st-name"></div>
    <div class="st-routes" id="st-routes"></div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  class BlueprintMap {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private wrapper: HTMLElement;
    private tooltip: HTMLElement;
    // Canvas (viewport) size, and the map's drawn size + offset inside it. The map
    // keeps its true aspect and cover-fits the canvas around FOCUS, like
    // object-fit: cover with an object-position on the East River confluence.
    private vw = 0;
    private vh = 0;
    private w = 0;
    private h = 0;
    private ox = 0;
    private oy = 0;
    private aspect = 1;
    private dpr = 1;

    private data: any = null;
    private visible = true;
    private hovering = false;
    private snapped: any = null;
    private mx = 0;
    private my = 0;
    private isMobile = false;
    private scrollY = 0;

    private staticCache: ImageBitmap | null = null;
    private staticDirty = true;
    private water: OffscreenCanvas | null = null;

    // Routes are line segments stitched end-to-end; cum (px along the route per
    // vertex) and stops (px offsets of stations on it) are rebuilt on resize.
    private routes: Array<{ pts: number[][]; cum: number[]; stops: number[] }> = [];
    // A train travels stop[leg] → stop[leg + dir], dwelling first, then easing along.
    private trains: Array<{ route: number; leg: number; dir: 1 | -1; clock: number; dwell: number }> = [];
    private lastTrainFrame = 0;
    private reducedMotion = false;

    private layers = {
      grid:     { alpha: 0, extentH: 0, extentV: 0 },
      water:    { alpha: 0 },
      borough:  { alpha: 0, strokeProgress: 0 },
      transit:  { alpha: 0, drawProgress: 0 },
      stations: { alpha: 0 },
      trains:   { alpha: 0 },
      ui:       { alpha: 0 },
    };
    private stationState: { scale: number }[] = [];
    private sortedStations: any[] = [];
    private transitSegLengths: number[] = [];
    private boroughPerimeters: number[] = [];

    // Ground (grid, water, shore) is warm graphite; burgundy is reserved for the
    // subway and trains so the subject leads.
    private C = {
      bg:        '#FFFEF9',
      land:      '#FFFEF9',
      shore:     'rgba(52,46,40,0.55)',
      grid:      'rgba(52,46,40,0.045)',
      transit:   'rgba(144,0,32,0.5)',
      node:      'rgba(144,0,32,0.65)',
      train:     '#900020',
      hover:     '#212121',
      cross:     'rgba(144,0,32,0.25)',
    };

    constructor() {
      this.canvas = document.getElementById('hero-map-canvas') as HTMLCanvasElement;
      this.wrapper = document.getElementById('blueprint-wrapper') as HTMLElement;
      this.tooltip = document.getElementById('station-tooltip') as HTMLElement;
      if (!this.canvas || !this.wrapper) return;
      this.ctx = this.canvas.getContext('2d', { alpha: false })!;
      const ann = document.getElementById('map-annotations');
      if (ann) ann.style.opacity = '0';
      this.boot();
    }

    private async boot() {
      try {
        const res = await fetch('/data/nyc-blueprint.json');
        this.data = await res.json();

        // Lines arrive as many short pieces sharing exact endpoints; stitch them
        // into continuous routes so trains run the length of a line.
        const same = (p: number[], q: number[]) => p[0] === q[0] && p[1] === q[1];
        for (const line of this.data.subwayLines) {
          const pool: number[][][] = line.segments.filter((s: number[][]) => s.length >= 2);
          while (pool.length) {
            const chain = [pool.shift()!];
            for (let grew = true; grew;) {
              grew = false;
              const head = chain[0][0];
              const tail = chain[chain.length - 1].at(-1)!;
              for (let i = 0; i < pool.length; i++) {
                const s = pool[i];
                if (same(tail, s[0])) chain.push(s);
                else if (same(tail, s.at(-1)!)) chain.push([...s].reverse());
                else if (same(head, s.at(-1)!)) chain.unshift(s);
                else if (same(head, s[0])) chain.unshift([...s].reverse());
                else continue;
                pool.splice(i, 1);
                grew = true;
                break;
              }
            }
            const pts = [chain[0][0]];
            for (const s of chain) pts.push(...s.slice(1));
            this.routes.push({ pts, cum: [], stops: [] });
          }
        }

        // Sort stations south-to-north (higher Y = further south in canvas coords)
        this.sortedStations = [...this.data.stations].sort((a: any, b: any) => b.pos[1] - a.pos[1]);
        this.stationState = this.sortedStations.map(() => ({ scale: 0 }));

        const { lonMin, lonMax, latMin, latMax } = this.data.meta.bounds;
        this.aspect = ((lonMax - lonMin) * Math.cos(((latMin + latMax) / 2) * Math.PI / 180)) / (latMax - latMin);

        // The hero resizes this box without a window resize (stacked layout, fonts), so watch the box.
        new ResizeObserver(() => { this.resize(); this.computeSegLengths(); }).observe(this.wrapper);
        this.wrapper.addEventListener('mousemove', this.onMove.bind(this));
        this.wrapper.addEventListener('mouseleave', () => {
          this.hovering = false;
          this.snapped = null;
          this.tooltip.classList.remove('visible');
        });

        this.resize();
        this.computeSegLengths();

        // One train per route with somewhere to go; long routes get a second
        // train starting from the far end.
        this.routes.forEach((r, route) => {
          if (r.stops.length < 3 || r.cum.at(-1)! < 120) return;
          const n = r.cum.at(-1)! > 600 ? 2 : 1;
          for (let i = 0; i < n; i++) {
            const leg = Math.floor(Math.random() * (r.stops.length - 1));
            this.trains.push({
              route,
              leg: i ? r.stops.length - 1 - leg : leg,
              dir: i ? -1 : 1,
              clock: Math.random() * 3,
              dwell: 0.8 + Math.random() * 0.8,
            });
          }
        });

        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (this.reducedMotion) {
          this.setAllLayersFinal();
          await this.buildStatic();
          this.startTrainLoop();
          this.dispatchTimelineReady(null);
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          for (const e of entries) {
            this.visible = e.isIntersecting;
            if (this.visible && !this.introStarted) {
              this.startIntro();
            }
          }
        }, { threshold: 0.05 });
        observer.observe(this.canvas);
      } catch (err) {
        console.error('BlueprintMap: failed to load data', err);
      }
    }

    private introStarted = false;
    private startIntro() {
      if (this.introStarted) return;
      this.introStarted = true;

      gsap.matchMedia().add('(max-width: 768px)', () => {
        this.isMobile = true;
        this.buildMobileTimeline();
      });
      gsap.matchMedia().add('(min-width: 769px)', () => {
        this.isMobile = false;
        this.buildDesktopTimeline();
      });
    }

    private buildDesktopTimeline() {
      const tl = gsap.timeline({
        delay: 0.15,
        onUpdate: () => this.renderIntroFrame(),
        onComplete: () => this.onIntroComplete(),
      });

      // Grid extends from edges (plotter establishing coordinates)
      tl.to(this.layers.grid, { extentH: 1, extentV: 1, duration: 0.6, ease: 'power2.out' }, 0);

      // Water lining fades in behind grid
      tl.to(this.layers.water, { alpha: 1, duration: 0.7, ease: 'power2.inOut' }, 0.2);

      // Borough fill masks hatching, coastline strokes itself
      tl.to(this.layers.borough, { alpha: 1, duration: 0.6, ease: 'power2.inOut' }, 0.6);
      tl.to(this.layers.borough, { strokeProgress: 1, duration: 1.0, ease: 'none' }, 0.7);

      // Transit lines draw in — the signature plotter moment
      tl.to(this.layers.transit, { alpha: 1, duration: 0.2 }, 1.0);
      tl.to(this.layers.transit, { drawProgress: 1, duration: 0.8, ease: 'power1.inOut' }, 1.05);

      // Station dots cascade south-to-north
      tl.to(this.stationState, {
        scale: 1, duration: 0.25, ease: 'back.out(1.7)',
        stagger: { each: 0.006, from: 0, ease: 'power2.in' },
      }, 1.5);
      tl.to(this.layers.stations, { alpha: 1, duration: 0.2 }, 1.5);

      // Trains fade in
      tl.to(this.layers.trains, { alpha: 1, duration: 0.5, ease: 'power2.inOut' }, 1.8);

      // UI annotations bridge into text reveals
      tl.to(this.layers.ui, { alpha: 1, duration: 0.5 }, 1.9);

      // Hold — prevents jarring switch from intro render to static cache
      tl.to({}, { duration: 0.3 });

      this.dispatchTimelineReady(tl);
    }

    private buildMobileTimeline() {
      const tl = gsap.timeline({
        onUpdate: () => this.renderIntroFrame(),
        onComplete: () => this.onIntroComplete(),
      });

      // Faster, simpler: alpha fades only
      tl.to(this.layers.grid, { alpha: 1, extentH: 1, extentV: 1, duration: 0.3 }, 0);
      tl.to(this.layers.water, { alpha: 1, duration: 0.3 }, 0.1);
      tl.to(this.layers.borough, { alpha: 1, strokeProgress: 1, duration: 0.4 }, 0.2);
      tl.to(this.layers.transit, { alpha: 1, drawProgress: 1, duration: 0.4 }, 0.4);
      // Skip station stagger on mobile — single alpha
      this.stationState.forEach(s => s.scale = 1);
      tl.to(this.layers.stations, { alpha: 1, duration: 0.3 }, 0.6);
      tl.to(this.layers.trains, { alpha: 1, duration: 0.3 }, 0.7);
      tl.to(this.layers.ui, { alpha: 1, duration: 0.3 }, 0.8);

      this.dispatchTimelineReady(tl);
    }

    private dispatchTimelineReady(tl: gsap.core.Timeline | null) {
      window.dispatchEvent(new CustomEvent('blueprint:timeline-ready', {
        detail: { timeline: tl, isMobile: this.isMobile },
      }));
    }

    private setAllLayersFinal() {
      this.layers.grid = { alpha: 1, extentH: 1, extentV: 1 };
      this.layers.water = { alpha: 1 };
      this.layers.borough = { alpha: 1, strokeProgress: 1 };
      this.layers.transit = { alpha: 1, drawProgress: 1 };
      this.layers.stations = { alpha: 1 };
      this.layers.trains = { alpha: 1 };
      this.layers.ui = { alpha: 1 };
      this.stationState.forEach(s => s.scale = 1);
      const ann = document.getElementById('map-annotations');
      if (ann) ann.style.opacity = '1';
    }

    private async onIntroComplete() {
      await this.buildStatic();
      this.startTrainLoop();
      this.setupScrollTrigger();
    }

    private setupScrollTrigger() {
      const hero = document.getElementById('hero');
      if (!hero) return;

      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: (self) => { this.scrollY = self.progress; },
      });

      // Fade canvas out as hero scrolls away
      ScrollTrigger.create({
        trigger: hero,
        start: '70% top',
        end: 'bottom top',
        onUpdate: (self) => { this.canvas.style.opacity = String(1 - self.progress); },
      });
    }

    private startTrainLoop() {
      const loop = () => {
        if (!this.visible) { requestAnimationFrame(loop); return; }
        this.renderPostIntro();
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }

    private resize() {
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = this.wrapper.getBoundingClientRect();
      this.vw = r.width;
      this.vh = r.height;
      this.canvas.width = this.vw * this.dpr;
      this.canvas.height = this.vh * this.dpr;
      const FOCUS = [0.4, 0.6];
      this.h = Math.max(this.vh, this.vw / this.aspect);
      this.w = this.h * this.aspect;
      this.ox = Math.min(0, Math.max(this.vw - this.w, this.vw / 2 - FOCUS[0] * this.w));
      this.oy = Math.min(0, Math.max(this.vh - this.h, this.vh / 2 - FOCUS[1] * this.h));
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      this.staticDirty = true;
      this.water = null;
    }

    private computeSegLengths() {
      if (!this.data) return;
      this.transitSegLengths = [];
      for (const line of this.data.subwayLines) {
        for (const seg of line.segments) {
          let len = 0;
          for (let i = 1; i < seg.length; i++) {
            len += Math.hypot((seg[i][0] - seg[i-1][0]) * this.w, (seg[i][1] - seg[i-1][1]) * this.h);
          }
          this.transitSegLengths.push(len);
        }
      }
      this.boroughPerimeters = [];
      if (this.data.boroughs) {
        for (const b of this.data.boroughs) {
          let perim = 0;
          for (const ring of b.rings) {
            for (let i = 1; i < ring.length; i++) {
              perim += Math.hypot((ring[i][0] - ring[i-1][0]) * this.w, (ring[i][1] - ring[i-1][1]) * this.h);
            }
          }
          this.boroughPerimeters.push(perim);
        }
      }

      for (const r of this.routes) {
        r.cum = [0];
        for (let i = 1; i < r.pts.length; i++) {
          r.cum.push(r.cum[i-1] + Math.hypot((r.pts[i][0] - r.pts[i-1][0]) * this.w, (r.pts[i][1] - r.pts[i-1][1]) * this.h));
        }
        const length = r.cum.at(-1)!;

        // Project every station onto the route; the ones it passes within 3px are stops.
        const found = [0, length];
        for (const st of this.data.stations) {
          const sx = st.pos[0] * this.w, sy = st.pos[1] * this.h;
          let best = 3, at = -1;
          for (let i = 1; i < r.pts.length; i++) {
            const ax = r.pts[i-1][0] * this.w, ay = r.pts[i-1][1] * this.h;
            const dx = r.pts[i][0] * this.w - ax, dy = r.pts[i][1] * this.h - ay;
            const segLen = r.cum[i] - r.cum[i-1];
            if (!segLen) continue;
            const t = Math.max(0, Math.min(1, ((sx - ax) * dx + (sy - ay) * dy) / (segLen * segLen)));
            const d = Math.hypot(ax + dx * t - sx, ay + dy * t - sy);
            if (d < best) { best = d; at = r.cum[i-1] + segLen * t; }
          }
          if (at >= 0) found.push(at);
        }
        // Merge stops closer than 18px so trains never make a twitchy hop.
        r.stops = [];
        for (const s of found.sort((a, b) => a - b)) {
          if (!r.stops.length || s - r.stops.at(-1)! >= 18) r.stops.push(s);
        }
        r.stops[r.stops.length - 1] = length;
      }
    }

    private pointAt(route: { pts: number[][]; cum: number[] }, d: number): [number, number] {
      const { pts, cum } = route;
      let lo = 1, hi = cum.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (cum[mid] < d) lo = mid + 1; else hi = mid;
      }
      const span = cum[lo] - cum[lo-1];
      const t = span ? (d - cum[lo-1]) / span : 0;
      return [
        (pts[lo-1][0] + (pts[lo][0] - pts[lo-1][0]) * t) * this.w,
        (pts[lo-1][1] + (pts[lo][1] - pts[lo-1][1]) * t) * this.h,
      ];
    }

    private onMove(e: MouseEvent) {
      if (!this.data || this.isMobile) return;
      this.hovering = true;
      const r = this.wrapper.getBoundingClientRect();
      this.mx = e.clientX - r.left;
      this.my = e.clientY - r.top;

      const yOff = this.scrollY * this.vh * 0.06;

      let nearest: any = null;
      let best = 50;
      for (const s of this.data.stations) {
        const d = Math.hypot(this.mx - (this.ox + s.pos[0] * this.w), this.my - (this.oy + s.pos[1] * this.h + yOff));
        if (d < best) { best = d; nearest = s; }
      }

      if (nearest !== this.snapped) {
        this.snapped = nearest;
        if (nearest) {
          document.getElementById('st-name')!.textContent = nearest.name;
          const routeEl = document.getElementById('st-routes')!;
          routeEl.innerHTML = (nearest.routes || '')
            .split('').filter((c: string) => c.trim())
            .map((c: string) => {
              const bg = this.routeColor(c);
              const dark = 'NQRWLnqrwl'.includes(c) ? ' route-dark' : '';
              return `<span class="route-badge${dark}" style="background:${bg}">${c}</span>`;
            }).join('');
          this.tooltip.classList.add('visible');
          this.tooltip.style.left = `${this.ox + nearest.pos[0] * this.w}px`;
          this.tooltip.style.top  = `${this.oy + nearest.pos[1] * this.h + yOff - 12}px`;
        } else {
          this.tooltip.classList.remove('visible');
        }
      }
    }

    private routeColor(route: string): string {
      const colors: Record<string, string> = {
        '1': '#EE352E', '2': '#EE352E', '3': '#EE352E',
        '4': '#00933C', '5': '#00933C', '6': '#00933C',
        '7': '#B933AD',
        'A': '#0039A6', 'C': '#0039A6', 'E': '#0039A6',
        'B': '#FF6319', 'D': '#FF6319', 'F': '#FF6319', 'M': '#FF6319',
        'G': '#6CBE45',
        'J': '#996633', 'Z': '#996633',
        'L': '#A7A9AC',
        'N': '#FCCC0A', 'Q': '#FCCC0A', 'R': '#FCCC0A', 'W': '#FCCC0A',
        'S': '#808183',
      };
      return colors[route] || '#808183';
    }

    /* ── Water lining: the engraved-map treatment, cached per size ──
       Hairlines trace every shore at widening spacing and fade offshore. Each ring
       is a wide graphite stroke of the land outline with a slightly narrower paper
       stroke on top; drawing outermost first lets nearer rings cut farther ones,
       leaving lines at a fixed distance from the nearest shore. Opaque paper base,
       so it is the bottom layer for both the intro and the static cache. */
    private waterLayer(): OffscreenCanvas {
      if (this.water) return this.water;
      const off = new OffscreenCanvas(Math.max(1, this.vw * this.dpr), Math.max(1, this.vh * this.dpr));
      const c = off.getContext('2d')!;
      c.scale(this.dpr, this.dpr);
      c.fillStyle = this.C.bg;
      c.fillRect(0, 0, this.vw, this.vh);
      c.translate(this.ox, this.oy);

      const land = new Path2D();
      for (const b of this.data.boroughs) {
        for (const ring of b.rings) {
          if (!ring.length) continue;
          land.moveTo(ring[0][0] * this.w, ring[0][1] * this.h);
          for (let i = 1; i < ring.length; i++) land.lineTo(ring[i][0] * this.w, ring[i][1] * this.h);
          land.closePath();
        }
      }

      const RINGS = [5, 9, 14, 20, 28, 38]; // px offshore; spacing widens like hand-ruled lining
      c.lineJoin = 'round';
      for (let i = RINGS.length - 1; i >= 0; i--) {
        c.strokeStyle = `rgba(52,46,40,${0.2 - i * 0.028})`;
        c.lineWidth = RINGS[i] * 2 + 0.5;
        c.stroke(land);
        c.strokeStyle = this.C.bg;
        c.lineWidth = RINGS[i] * 2 - 0.5;
        c.stroke(land);
      }
      c.fillStyle = this.C.land;
      c.fill(land);
      return (this.water = off);
    }

    /* ── Static layer: rendered once post-intro, cached as bitmap ── */
    private async buildStatic() {
      // A stacked hero on a short landscape phone can squeeze the box to nothing;
      // stay dirty and rebuild once it has size (createImageBitmap throws on 0×0).
      if (!this.vw || !this.vh) return;
      const off = new OffscreenCanvas(this.vw * this.dpr, this.vh * this.dpr);
      const c = off.getContext('2d')!;
      c.scale(this.dpr, this.dpr);

      c.drawImage(this.waterLayer(), 0, 0, this.vw, this.vh);
      c.translate(this.ox, this.oy);

      // Grid
      c.strokeStyle = this.C.grid;
      c.lineWidth = 0.5;
      c.beginPath();
      for (let x = 0; x <= this.w; x += 60) { c.moveTo(x, 0); c.lineTo(x, this.h); }
      for (let y = 0; y <= this.h; y += 60) { c.moveTo(0, y); c.lineTo(this.w, y); }
      c.stroke();

      // Boroughs
      if (this.data?.boroughs) {
        c.fillStyle = this.C.land;
        c.strokeStyle = this.C.shore;
        c.lineWidth = 0.75;
        for (const b of this.data.boroughs) {
          c.beginPath();
          for (const ring of b.rings) {
            if (!ring.length) continue;
            c.moveTo(ring[0][0] * this.w, ring[0][1] * this.h);
            for (let i = 1; i < ring.length; i++) c.lineTo(ring[i][0] * this.w, ring[i][1] * this.h);
          }
          c.fill();
          c.stroke();
        }
      }

      // Transit lines (dashed) — batched into single path
      if (this.data?.subwayLines) {
        c.strokeStyle = this.C.transit;
        c.lineWidth = 1.25;
        c.setLineDash([3, 5]);
        c.beginPath();
        for (const line of this.data.subwayLines) {
          for (const seg of line.segments) {
            c.moveTo(seg[0][0] * this.w, seg[0][1] * this.h);
            for (let i = 1; i < seg.length; i++) c.lineTo(seg[i][0] * this.w, seg[i][1] * this.h);
          }
        }
        c.stroke();
        c.setLineDash([]);
      }



      // Station dots
      if (this.data?.stations) {
        c.fillStyle = this.C.bg;
        c.strokeStyle = this.C.node;
        c.lineWidth = 1;
        for (const s of this.data.stations) {
          c.beginPath();
          c.arc(s.pos[0] * this.w, s.pos[1] * this.h, 2, 0, Math.PI * 2);
          c.fill();
          c.stroke();
        }
      }



      this.staticCache = await createImageBitmap(off);
      this.staticDirty = false;
    }

    /* ── Intro frame: reads GSAP-driven layer state ── */
    private renderIntroFrame() {
      if (!this.data || !this.w) return;
      const ctx = this.ctx;
      const L = this.layers;

      ctx.fillStyle = this.C.bg;
      ctx.fillRect(0, 0, this.vw, this.vh);

      // Water lining
      if (L.water.alpha > 0) {
        ctx.globalAlpha = L.water.alpha;
        ctx.drawImage(this.waterLayer(), 0, 0, this.vw, this.vh);
        ctx.globalAlpha = 1;
      }

      ctx.save();
      ctx.translate(this.ox, this.oy);

      // Grid — lines extend from edges
      if (L.grid.extentH > 0 || L.grid.extentV > 0) {
        ctx.globalAlpha = L.grid.alpha || 1;
        ctx.strokeStyle = this.C.grid;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        if (L.grid.extentH > 0) {
          for (let y = 0; y <= this.h; y += 60) {
            ctx.moveTo(0, y);
            ctx.lineTo(this.w * L.grid.extentH, y);
          }
        }
        if (L.grid.extentV > 0) {
          for (let x = 0; x <= this.w; x += 60) {
            ctx.moveTo(x, 0);
            ctx.lineTo(x, this.h * L.grid.extentV);
          }
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

      // Boroughs — fill fades, coastline strokes progressively
      if (L.borough.alpha > 0 && this.data.boroughs) {
        for (let bi = 0; bi < this.data.boroughs.length; bi++) {
          const b = this.data.boroughs[bi];
          ctx.beginPath();
          for (const ring of b.rings) {
            if (!ring.length) continue;
            ctx.moveTo(ring[0][0]*this.w, ring[0][1]*this.h);
            for (let i = 1; i < ring.length; i++) ctx.lineTo(ring[i][0]*this.w, ring[i][1]*this.h);
          }
          ctx.fillStyle = this.C.land;
          ctx.fill();

          // Progressive stroke
          const perim = this.boroughPerimeters[bi] || 1000;
          ctx.strokeStyle = this.C.shore;
          ctx.lineWidth = 0.75;
          ctx.globalAlpha = L.borough.alpha;
          ctx.setLineDash([perim, perim]);
          ctx.lineDashOffset = perim * (1 - L.borough.strokeProgress);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.lineDashOffset = 0;
          ctx.globalAlpha = 1;
        }
      }

      // Transit — plotter path drawing
      if (L.transit.alpha > 0 && this.data.subwayLines) {
        ctx.globalAlpha = L.transit.alpha;
        ctx.strokeStyle = this.C.transit;
        ctx.lineWidth = 1.25;
        let segIdx = 0;
        for (const line of this.data.subwayLines) {
          for (const seg of line.segments) {
            const len = this.transitSegLengths[segIdx] || 500;
            ctx.setLineDash([len, len]);
            ctx.lineDashOffset = len * (1 - L.transit.drawProgress);
            ctx.beginPath();
            ctx.moveTo(seg[0][0]*this.w, seg[0][1]*this.h);
            for (let i = 1; i < seg.length; i++) ctx.lineTo(seg[i][0]*this.w, seg[i][1]*this.h);
            ctx.stroke();
            segIdx++;
          }
        }
        ctx.setLineDash([]);
        ctx.lineDashOffset = 0;
        ctx.globalAlpha = 1;
      }



      // Station dots — stagger bounce
      if (L.stations.alpha > 0) {
        ctx.globalAlpha = L.stations.alpha;
        for (let i = 0; i < this.sortedStations.length; i++) {
          const s = this.sortedStations[i];
          const sc = this.stationState[i].scale;
          if (sc <= 0) continue;
          const r = 2 * sc;
          ctx.fillStyle = this.C.bg;
          ctx.strokeStyle = this.C.node;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(s.pos[0]*this.w, s.pos[1]*this.h, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      }



      // Trains during intro
      if (L.trains.alpha > 0) {
        this.drawTrains(L.trains.alpha);
      }
      ctx.restore();

      // UI annotations
      const ann = document.getElementById('map-annotations');
      if (ann) ann.style.opacity = String(L.ui.alpha);
    }

    /* ── Post-intro: blit static + dynamic overlay ── */
    private renderPostIntro() {
      if (this.staticDirty || !this.staticCache) {
        this.buildStatic();
        return;
      }
      const ctx = this.ctx;
      const yOff = this.scrollY * this.vh * 0.06;

      ctx.fillStyle = this.C.bg;
      ctx.fillRect(0, 0, this.vw, this.vh);

      // Apply parallax offset to everything so trains stay on tracks
      ctx.save();
      ctx.translate(0, yOff);

      ctx.drawImage(this.staticCache!, 0, 0, this.vw, this.vh);
      ctx.translate(this.ox, this.oy);

      this.drawTrains(1);

      // Hovered station
      if (this.snapped && !this.isMobile) {
        const sx = this.snapped.pos[0] * this.w;
        const sy = this.snapped.pos[1] * this.h;
        ctx.beginPath();
        ctx.arc(sx, sy, 5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(144,0,32,0.12)';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(sx, sy, 3, 0, Math.PI * 2);
        ctx.strokeStyle = this.C.hover;
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      ctx.restore();

      // Crosshair stays in screen space (follows mouse, not parallax)
      if (this.hovering && !this.isMobile) {
        let cx = this.mx, cy = this.my;
        if (this.snapped) {
          cx = this.ox + this.snapped.pos[0] * this.w;
          cy = this.oy + this.snapped.pos[1] * this.h + yOff;
        }
        ctx.strokeStyle = this.C.cross;
        ctx.lineWidth = 0.5;
        ctx.setLineDash([4, 6]);
        ctx.beginPath();
        ctx.moveTo(cx, 0); ctx.lineTo(cx, this.vh);
        ctx.moveTo(0, cy); ctx.lineTo(this.vw, cy);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.font = '9px monospace';
        ctx.fillStyle = 'rgba(144,0,32,0.4)';
        ctx.fillText(`${((cx - this.ox) / this.w).toFixed(3)}, ${((cy - this.oy - yOff) / this.h).toFixed(3)}`, cx + 8, cy - 6);
      }
    }

    private drawTrains(alpha: number) {
      const ctx = this.ctx;
      const now = performance.now();
      // Wall-clock step so speed is the same at 60 Hz and 120 Hz; clamped so a
      // hidden tab doesn't make every train jump on return.
      const dt = this.lastTrainFrame && !this.reducedMotion ? Math.min((now - this.lastTrainFrame) / 1000, 0.1) : 0;
      this.lastTrainFrame = now;
      const SPEED = 34;  // px/s average between stops
      const TAIL = 38;   // px of lit track behind a train at full speed

      ctx.lineCap = 'round';
      for (const tr of this.trains) {
        const route = this.routes[tr.route];
        const S = route.stops;
        tr.leg = Math.min(tr.leg, S.length - 1);
        if (tr.leg + tr.dir < 0 || tr.leg + tr.dir >= S.length) tr.dir = tr.dir === 1 ? -1 : 1;

        // Advance: dwell at the stop, then glide to the next; reverse at termini.
        tr.clock += dt;
        let from = S[tr.leg], to = S[tr.leg + tr.dir];
        let travel = Math.max(Math.abs(to - from) / SPEED, 0.6);
        while (tr.clock >= tr.dwell + travel) {
          tr.clock -= tr.dwell + travel;
          tr.leg += tr.dir;
          if (tr.leg + tr.dir < 0 || tr.leg + tr.dir >= S.length) tr.dir = tr.dir === 1 ? -1 : 1;
          from = S[tr.leg];
          to = S[tr.leg + tr.dir];
          travel = Math.max(Math.abs(to - from) / SPEED, 0.6);
        }
        const u = Math.max(0, Math.min(1, (tr.clock - tr.dwell) / travel));
        const d = from + (to - from) * (0.5 - 0.5 * Math.cos(Math.PI * u));
        const velocity = Math.sin(Math.PI * u); // 0 at stops, 1 mid-leg
        const [px, py] = this.pointAt(route, d);

        // Lit track behind the train: follows the curve, fades to nothing,
        // and retracts as the train slows into a station.
        const tailLen = TAIL * velocity;
        if (tailLen > 1) {
          const end = Math.max(0, Math.min(route.cum.at(-1)!, d - Math.sign(to - from) * tailLen));
          const [ex, ey] = this.pointAt(route, end);
          const grad = ctx.createLinearGradient(px, py, ex, ey);
          grad.addColorStop(0, 'rgba(144,0,32,0.85)');
          grad.addColorStop(1, 'rgba(144,0,32,0)');
          ctx.globalAlpha = alpha;
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(px, py);
          if (end < d) {
            for (let i = route.cum.length - 1; i >= 0; i--) {
              if (route.cum[i] < d && route.cum[i] > end) ctx.lineTo(route.pts[i][0] * this.w, route.pts[i][1] * this.h);
            }
          } else {
            for (let i = 0; i < route.cum.length; i++) {
              if (route.cum[i] > d && route.cum[i] < end) ctx.lineTo(route.pts[i][0] * this.w, route.pts[i][1] * this.h);
            }
          }
          ctx.lineTo(ex, ey);
          ctx.stroke();
        }

        // Hairline berth ring that settles in while the train is at a stop.
        if (velocity < 0.3) {
          ctx.globalAlpha = alpha * 0.3 * (1 - velocity / 0.3);
          ctx.strokeStyle = this.C.train;
          ctx.lineWidth = 0.75;
          ctx.beginPath();
          ctx.arc(px, py, 5.5, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Head: solid burgundy, cut out from the dashed track by a paper halo.
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(px, py, 2.25, 0, Math.PI * 2);
        ctx.strokeStyle = this.C.bg;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = this.C.train;
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      ctx.lineCap = 'butt';
    }
  }

  new BlueprintMap();
</script>

