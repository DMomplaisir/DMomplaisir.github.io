---
/*
 * Homepage - Dylan Momplaisir Portfolio
 * Elevation Grid + Blueprint Light Design System
 * Warm minimalism with architectural precision
 */

import { getFeaturedProjects } from '../utils/content-helpers';
import SEO from '../components/SEO.astro';
import ViewTransitionsHead from '../components/ViewTransitionsHead.astro';
import PageTransition from '../components/PageTransition.astro';
import Navigation from '../components/Navigation.astro';
import InteractiveLanding from '../components/InteractiveLanding.astro';
import BlueprintMap from '../components/BlueprintMap.astro';
import Footer from '../components/Footer.astro';

import '../styles/variables.css';
import '../styles/fonts.css';

const featuredProjects = (await getFeaturedProjects()).slice(0, 3);

const pageTitle = "Dylan Momplaisir - Full-Stack Engineer";
const pageDescription = "Full-stack engineer at The Atlantic. Building audio and content platforms that scale—with the systems thinking of an urbanist.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>

  <SEO
    title={pageTitle}
    description={pageDescription}
    type="website"
  />

  <!-- Preconnect to fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="Dylan Momplaisir - Projects" href="/rss.xml">
  <meta name="theme-color" content="#900020">
  <ViewTransitionsHead />
</head>

<body>
  <PageTransition>
  <!-- Subtle Grid Background (permanent, 2-3% opacity) -->
  <div class="grid-background" aria-hidden="true"></div>
  <Navigation />

  <!-- Elevation 0.0m: Hero Section -->
  <section class="hero-section elevation-0" id="hero">
    <div class="hero-split">
      <div class="hero-panel-text">
        <div class="elevation-marker" aria-hidden="true">
          <span class="marker-line"></span>
          <span class="marker-label">0.0m</span>
        </div>

        <div class="hero-title-block" id="hero-title-block">
          <div class="tb-section tb-header" data-reveal="0">
            <span class="tb-dwg">DM-001</span>
            <h1 class="tb-name">Dylan<br>Momplaisir</h1>
          </div>
          <div class="tb-rule" data-reveal="0" aria-hidden="true"></div>
          <div class="tb-section tb-desc" data-reveal="1">
            <p>I think about software the way I used to think about cities — who moves through it, what breaks, what lasts.</p>
          </div>
          <div class="tb-rule" data-reveal="1" aria-hidden="true"></div>
          <div class="tb-section tb-role" data-reveal="2">
            <p>Building platforms at <strong>The Atlantic</strong>: audio systems, search infrastructure, tools that scale.</p>
          </div>
          <div class="tb-rule" data-reveal="2" aria-hidden="true"></div>
          <div class="tb-section tb-actions" data-reveal="3">
            <a href="#work" class="tb-link">VIEW WORK</a>
            <span class="tb-sep" aria-hidden="true">—</span>
            <a href="/resume.pdf" class="tb-link">RESUME.PDF</a>
          </div>
        </div>

        <a href="#work" class="scroll-indicator" aria-label="Scroll to view work">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="7 13 12 18 17 13"></polyline>
            <polyline points="7 6 12 11 17 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="hero-panel-map">
        <BlueprintMap fullscreen={true} />
      </div>
    </div>

    <!-- Hero reveal is driven by BlueprintMap's timeline via custom event.
         Section reveals + scroll indicator are handled in the unified script below. -->
    <script>
      import { gsap } from 'gsap';

      (function heroReveal() {
        const block = document.getElementById('hero-title-block');
        if (!block) return;
        const sections = block.querySelectorAll<HTMLElement>('[data-reveal]');
        const hero = document.getElementById('hero');
        if (!hero) return;
        const indicator = hero.querySelector<HTMLElement>('.scroll-indicator');

        const revealByViewport = (isMobile: boolean) => {
          sections.forEach(el => {
            const idx = parseInt(el.dataset.reveal || '0', 10);
            const show = !isMobile || idx <= 1;
            gsap.set(el, {
              clipPath: show ? 'inset(0 0% 0 0)' : 'inset(0 100% 0 0)',
              opacity: show ? 1 : 0,
              y: show ? 0 : 14,
            });
          });
          if (indicator) gsap.set(indicator, { opacity: 1 });
        };

        gsap.set(sections, { clipPath: 'inset(0 100% 0 0)', opacity: 0, y: 14, willChange: 'clip-path, opacity, transform' });
        if (indicator) gsap.set(indicator, { opacity: 0 });

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealByViewport(window.matchMedia('(max-width: 768px)').matches);
          return;
        }

        let resolved = false;

        const DESKTOP_POSITIONS = [2.0, 2.15, 2.3, 2.45];
        const MOBILE_POSITIONS  = [0.8, 0.9];

        window.addEventListener('blueprint:timeline-ready', ((e: CustomEvent) => {
          if (resolved) return;
          resolved = true;

          const tl = e.detail.timeline as gsap.core.Timeline | null;
          const isMobile: boolean = e.detail.isMobile;

          if (!tl) {
            revealByViewport(isMobile);
            return;
          }

          sections.forEach(el => {
            const idx = parseInt(el.dataset.reveal || '0', 10);
            if (isMobile && idx > 1) return;
            const pos = isMobile
              ? (MOBILE_POSITIONS[idx] ?? 0.9)
              : (DESKTOP_POSITIONS[idx] ?? 2.6);
            tl.to(el, {
              clipPath: 'inset(0 0% 0 0)',
              opacity: 1,
              y: 0,
              duration: 0.5,
              ease: 'power4.out',
            }, pos);
          });

          if (indicator) {
            tl.to(indicator, {
              opacity: 1,
              duration: 0.6,
              ease: 'power2.out',
            }, isMobile ? 1.0 : 2.65);
          }
        }) as EventListener, { once: true });

        gsap.delayedCall(5, () => {
          if (!resolved) {
            revealByViewport(window.matchMedia('(max-width: 768px)').matches);
            resolved = true;
          }
        });
      })();
    </script>
  </section>

  <!-- Elevation +2.4m: Featured Work (scroll through stacked cards) -->
  <section class="featured-work elevation-24" id="work">
    <div class="featured-work-inner">
    <div class="container">
      <div class="elevation-marker" aria-hidden="true">
        <span class="marker-line"></span>
        <span class="marker-label">+2.4m</span>
      </div>

      <h2 class="section-heading">Selected Work</h2>
      <p class="section-subtitle">Featured projects spanning full-stack engineering, product development, and technical leadership.</p>

      <!-- Stacked cards: each card is sticky with incremental top so they stack as you scroll (CSS-Tricks style) -->
      <div class="project-stack-container">
        <div class="project-stack project-stack--scrollstack">
          {featuredProjects.map((project, index) => (
            <article class="project-card" id={`work-card-${index}`} data-index={index}>
              <a href={`/projects/${project.id}/`} class="card-link">
                <!-- Paper texture overlay -->
                <div class="paper-texture" aria-hidden="true"></div>

                <!-- Blueprint Overlay (appears on hover) -->
                <div class="blueprint-overlay" aria-hidden="true">
                  <svg class="blueprint-grid" width="100%" height="100%">
                    <defs>
                      <pattern id={`grid-${project.id.replace(/\//g, '-')}`} width="20" height="20" patternUnits="userSpaceOnUse">
                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--blueprint-line)" stroke-width="1"/>
                      </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill={`url(#grid-${project.id.replace(/\//g, '-')})`} />
                  </svg>
                </div>

                <!-- Architectural Corner Accents -->
                <div class="corner-accent corner-tl" aria-hidden="true"></div>
                <div class="corner-accent corner-br" aria-hidden="true"></div>

                <div class="card-content">
                  <!-- Year Badge (architectural style) -->
                  {project.data.date && (
                    <div class="year-badge" aria-label={`Year: ${new Date(project.data.date).getFullYear()}`}>
                      {new Date(project.data.date).getFullYear()}
                    </div>
                  )}

                  <h3 class="project-title">{project.data.title}</h3>
                  <p class="project-description">{project.data.description}</p>

                  <!-- Technical Specifications -->
                  <div class="project-meta">
                    {project.data.tech_stack && (
                      <div class="meta-item">
                        <span class="meta-label">Tech</span>
                        <span class="meta-value">{project.data.tech_stack.slice(0, 4).join(', ')}</span>
                      </div>
                    )}
                    {project.data.impact && (
                      <div class="meta-item">
                        <span class="meta-label">Impact</span>
                        <span class="meta-value">{project.data.impact}</span>
                      </div>
                    )}
                  </div>

                  <span class="view-project">View Full Case Study →</span>
                </div>
              </a>
            </article>
          ))}
        </div>

      <a href="/projects" class="view-all">View All Projects →</a>
    </div>
    </div>
  </section>

  <!-- Elevation +4.8m: About Preview -->
  <section class="about-preview elevation-48" id="about">
    <div class="container-narrow">
      <div class="elevation-marker" aria-hidden="true">
        <span class="marker-line"></span>
        <span class="marker-label">+4.8m</span>
      </div>

      <h2 class="section-heading">About</h2>
      <div class="about-content">
        <p class="large-text">
          I build digital products that solve real problems.
          <span class="highlight">5+ years shipping features at scale</span>, specializing in
          product engineering and technical leadership.
        </p>
        <p class="body-text">
          From urbanism to full-stack engineering—my path bridges architecture,
          data journalism, and product development. I bring systems thinking to every project,
          creating platforms that transform how we tell stories and understand our world.
        </p>
      </div>
      <a href="/about" class="learn-more">Learn More →</a>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

  <!-- Interactive Features -->
  <InteractiveLanding />

  </PageTransition>

  <!-- Scroll-triggered section reveals (unified gsap.context) -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      mm.add(
        {
          isDesktop: '(min-width: 769px)',
          isMobile: '(max-width: 768px)',
          isReduced: '(prefers-reduced-motion: reduce)',
        },
        (context) => {
          const { isReduced } = context.conditions!;
          if (isReduced) return;

          // ── Batched section reveals ──
          ScrollTrigger.batch(
            '.featured-work .section-heading, .featured-work .section-subtitle, .project-stack-container, .featured-work .view-all',
            {
              start: 'top 60%',
              onEnter: (batch) => {
                gsap.from(batch, {
                  y: 24,
                  opacity: 0,
                  duration: 0.55,
                  ease: 'power3.out',
                  stagger: 0.08,
                  overwrite: true,
                });
              },
              once: true,
            },
          );

          ScrollTrigger.batch(
            '.about-preview .section-heading, .about-content .large-text, .about-content .body-text, .about-preview .learn-more',
            {
              start: 'top 55%',
              onEnter: (batch) => {
                gsap.from(batch, {
                  y: 20,
                  opacity: 0,
                  duration: 0.5,
                  ease: 'power3.out',
                  stagger: 0.1,
                  overwrite: true,
                });
              },
              once: true,
            },
          );

          // ── Card stacking (scrub-driven, per-card trigger) ──
          const projectCards = gsap.utils.toArray<HTMLElement>('.project-card');
          projectCards.forEach((card, i) => {
            const nextCard = projectCards[i + 1];
            if (!nextCard) return;
            gsap.to(card, {
              scale: 0.94,
              opacity: 0.4,
              scrollTrigger: {
                trigger: nextCard,
                start: 'top 85%',
                end: 'top 180px',
                scrub: true,
              },
            });
          });

          // ── Scroll indicator fade (single owner) ──
          gsap.to('.hero-section .scroll-indicator', {
            opacity: 0,
            ease: 'none',
            scrollTrigger: {
              trigger: '#hero',
              start: 'top top',
              end: '15% top',
              scrub: true,
            },
          });
        },
      );
    });

    // Cleanup on Astro page transitions (View Transitions API)
    document.addEventListener('astro:before-swap', () => ctx.revert());
  </script>
</body>
</html>

<style>
  /* ==================== GLOBAL RESETS ==================== */

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    color: var(--text-primary);
    background-color: var(--warm-white);
    background-image:
      repeating-linear-gradient(0deg, rgba(144, 0, 32, 0.018) 0 1px, transparent 1px 60px),
      repeating-linear-gradient(90deg, rgba(144, 0, 32, 0.018) 0 1px, transparent 1px 60px);
    line-height: var(--leading-normal);
    overflow-x: hidden;
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ==================== GRID BACKGROUND ==================== */

  .grid-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--blueprint-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--blueprint-line) 1px, transparent 1px);
    background-size: var(--grid-unit) var(--grid-unit);
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }

  /* Footer scrolls on top of stacked sections */
  .site-footer {
    position: relative;
    z-index: 10;
  }

  .hero-section,
  .featured-work,
  .about-preview {
    scroll-margin-top: calc(var(--header-height-collapsed) + var(--space-sm));
  }

  /* ==================== ELEVATION MARKERS ==================== */

  .elevation-marker {
    position: absolute;
    left: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    opacity: 0.4;
    transition: opacity var(--transition-base);
  }

  section:hover .elevation-marker {
    opacity: 0.7;
  }

  .marker-line {
    width: 16px;
    height: 1px;
    background: var(--concrete-400);
  }

  .marker-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--concrete-400);
    letter-spacing: var(--tracking-wide);
  }

  /* ==================== HERO SECTION (Elevation 0.0m) ==================== */

  .hero-section {
    position: sticky;
    top: 0;
    min-height: 100vh;
    height: 100vh;
    z-index: 1;
    color: var(--concrete-900);
  }

  .hero-split {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
  }

  /* ── Left panel: text ── */

  .hero-panel-text {
    position: relative;
    width: 38%;
    min-width: 320px;
    max-width: 440px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xxl) var(--space-xl);
    background: var(--warm-white);
    border-right: 1px solid rgba(144, 0, 32, 0.1);
    z-index: 2;
  }

  .hero-panel-text .elevation-marker {
    top: var(--space-xl);
    opacity: 0.6;
  }

  .hero-panel-text .marker-label {
    color: var(--concrete-400);
  }

  .hero-panel-text .marker-line {
    background: var(--concrete-400);
  }

  .hero-panel-text .scroll-indicator {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(144, 0, 32, 0.4);
    animation: scrollBounce 2.5s cubic-bezier(0.37, 0, 0.63, 1) infinite;
    opacity: 0;
    pointer-events: auto;
  }

  .hero-panel-text .scroll-indicator:hover {
    color: var(--burgundy-primary);
  }

  /* ── Right panel: map ── */

  .hero-panel-map {
    flex: 1;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  /* ── Architectural Title Block ── */

  .hero-title-block {
    border: 1px solid rgba(144, 0, 32, 0.18);
    font-family: var(--font-mono);
    width: 100%;
  }

  .tb-section {
    padding: 12px 18px;
  }

  .tb-rule {
    height: 1px;
    background: rgba(144, 0, 32, 0.12);
    margin: 0;
  }

  .tb-dwg {
    display: block;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(144, 0, 32, 0.45);
    margin-bottom: 8px;
  }

  .tb-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: var(--weight-regular);
    font-variation-settings: 'wdth' 75;
    color: var(--concrete-900);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin: 0;
  }

  .tb-desc p,
  .tb-role p {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    color: var(--concrete-600, #555);
    margin: 0;
  }

  .tb-role strong {
    color: var(--concrete-900);
    font-weight: 600;
  }

  .tb-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tb-link {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--burgundy-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .tb-link:hover {
    color: var(--burgundy-hover);
  }

  .tb-sep {
    font-size: 10px;
    color: rgba(144, 0, 32, 0.25);
  }

  /* Reveal state is set via JS + GSAP timeline */

  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ==================== FEATURED WORK (Elevation +2.4m) ==================== */

  .featured-work {
    position: relative;
    min-height: 100vh;
    overflow: visible;
    padding: 0;
    background: var(--cream);
    z-index: 2;
    box-shadow: 0 -1px 0 var(--warm-gray-200), 0 -4px 24px rgba(0, 0, 0, 0.04);
  }

  .featured-work-inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(var(--space-xl), 5vh, var(--space-xxl)) var(--space-lg) clamp(var(--space-xl), 5vh, var(--space-xxl));
  }

  .featured-work .elevation-marker {
    top: clamp(var(--space-lg), 4vh, var(--space-xxl));
  }

  .container {
    width: 100%;
    max-width: var(--width-narrow);
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--weight-regular);
    color: var(--concrete-900);
    margin-bottom: var(--space-md);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--concrete-400);
    margin-bottom: clamp(var(--space-lg), 4vh, var(--space-xl));
    max-width: 60ch;
  }

  /* ==================== STACKED PAPERS PROJECT CARDS ==================== */

  .project-stack-container {
    position: relative;
    overflow: visible;
    margin-bottom: clamp(var(--space-lg), 3vh, var(--space-xl));
    padding: var(--space-md) 0;
  }

  .project-stack {
    position: relative;
    overflow: visible;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  /* True sticky stack: cards naturally stack in-flow while scrolling down and up. */
  .project-stack--scrollstack {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-stack--scrollstack .project-card {
    position: sticky;
    width: 100%;
    margin-bottom: 60vh; /* Creates scroll space between cards */
    transition:
      box-shadow 0.35s ease-out,
      border-color 0.25s ease-out;
    box-shadow: var(--shadow-md);
    background: var(--warm-white);
  }

  .project-stack--scrollstack .project-card:last-child {
    margin-bottom: 25vh; /* Space before View All link */
  }

  /* Staggered sticky tops and increasing z-index for stacking on top */
  .project-stack--scrollstack .project-card:nth-child(1) {
    top: 80px;
    z-index: 10;
  }

  .project-stack--scrollstack .project-card:nth-child(2) {
    top: 110px;
    z-index: 20;
  }

  .project-stack--scrollstack .project-card:nth-child(3) {
    top: 140px;
    z-index: 30;
  }

  .project-card {
    position: relative;
    width: 100%;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    will-change: transform, opacity;
  }

  .project-card:hover {
    border-left: 3px solid var(--burgundy-primary);
    box-shadow: var(--shadow-lg);
  }

  .project-card:hover .blueprint-overlay,
  .project-card:hover .corner-accent {
    opacity: 0.6;
  }

  .project-card:active {
    transform: translateY(-2px) scale(0.99);
  }

  /* Paper texture */
  .paper-texture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.01) 2px,
        rgba(0, 0, 0, 0.01) 4px
      );
    pointer-events: none;
    opacity: 0.3;
    z-index: 1;
  }

  .blueprint-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.35s var(--ease-smooth) 0.08s;
    pointer-events: none;
    z-index: 2;
  }

  .corner-accent {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 1px solid var(--burgundy-primary);
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: 3;
  }

  .corner-tl {
    top: var(--space-sm);
    left: var(--space-sm);
    border-right: none;
    border-bottom: none;
  }

  .corner-br {
    bottom: var(--space-sm);
    right: var(--space-sm);
